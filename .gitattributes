# Unity text assets: normalise line endings, merge as text
*.cs      text eol=lf diff=csharp
*.unity   text eol=lf merge=unityyamlmerge
*.prefab  text eol=lf merge=unityyamlmerge
*.asset   text eol=lf merge=unityyamlmerge
*.mat     text eol=lf merge=unityyamlmerge
*.anim    text eol=lf merge=unityyamlmerge
*.controller text eol=lf merge=unityyamlmerge
*.meta    text eol=lf

# Binary files are stored as plain git objects for now. Git LFS was dropped
# because GitHub's "Download ZIP" leaves LFS files out by default. Revisit
# if the repo grows large (big models or audio).
*.png  binary
*.jpg  binary
*.fbx  binary
*.wav  binary
