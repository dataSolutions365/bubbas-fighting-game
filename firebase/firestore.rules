rules_version = '2';

// Points, owned abilities, matches and the ledger are written ONLY by
// Cloud Functions (the Admin SDK bypasses these rules). The game client
// can read its own data and change a few cosmetic profile fields.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Catalogs: readable by any signed-in player, edited only by you
    // through the console or the seed script.
    match /abilities/{abilityId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /fighters/{fighterId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /players/{uid} {
      allow read: if isOwner(uid);
      allow create, delete: if false;

      // Only the display name and selected fighter may change from the client.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'selectedFighter'])
        && (!('displayName' in request.resource.data)
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() >= 1
                && request.resource.data.displayName.size() <= 24))
        && (!('selectedFighter' in request.resource.data)
            || request.resource.data.selectedFighter is string);

      match /ownedAbilities/{abilityId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /matches/{matchId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /ledger/{entryId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // Real-money receipts (paid tier, later). Server only.
    match /receipts/{receiptId} {
      allow read, write: if false;
    }
  }
}
