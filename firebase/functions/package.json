{
  "name": "bubbas-fighting-game-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "serve": "npm run build && firebase emulators:start --config ../firebase.json --project demo-bubba",
    "deploy": "firebase deploy --config ../firebase.json --only functions,firestore",
    "test:rules": "firebase emulators:exec --config ../firebase.json --only firestore --project demo-bubba \"vitest run test/rules.test.ts\""
  },
  "dependencies": {
    "@google-cloud/billing": "^4.6.0",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^14.27.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
